{
  "name": "zenvest-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "start": "cd app && expo start",
    "android": "cd app && expo run:android",
    "ios": "cd app && expo run:ios"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "concurrently": "^8.2.2"
  }
}
