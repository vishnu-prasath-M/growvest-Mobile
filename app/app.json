{
  "expo": {
    "name": "Growvest",
    "slug": "zenvest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#085428"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growvest.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "googlepay",
          "phonepe",
          "paytm",
          "bhim"
        ]
      }
    },
    "android": {
      "package": "com.growvest.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/growvest-logo.png",
        "backgroundColor": "#085428"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#085428",
          "defaultChannel": "growvest-default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "owner": "my-player",
    "extra": {
      "eas": {
        "projectId": "f4211c90-3448-400b-9e0c-82933dd6dbed"
      }
    }
  }
}
