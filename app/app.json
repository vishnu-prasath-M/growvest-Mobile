{
  "expo": {
    "name": "Growvest",
    "slug": "zenvest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/growvest-logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/growvest-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#085428"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growvest.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "googlepay",
          "phonepe",
          "paytm",
          "bhim"
        ]
      }
    },
    "scheme": "growvest",
    "android": {
      "package": "com.growvest.mobile",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "growvest"
            },
            {
              "scheme": "https",
              "host": "growvest-mobile.onrender.com",
              "pathPrefix": "/ref"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/growvest-logo.png",
        "backgroundColor": "#085428"
      }
    },
    "web": {
      "favicon": "./assets/growvest-logo.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "owner": "my-player",
    "extra": {
      "eas": {
        "projectId": "f4211c90-3448-400b-9e0c-82933dd6dbed"
      }
    }
  }
}