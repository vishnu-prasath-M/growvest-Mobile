{
  "expo": {
    "name": "Growvest",
    "slug": "zenvest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo-h.jpeg",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/logo-h.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#085428"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growvest.mobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["upi", "googlepay", "phonepe", "paytm", "bhim"]
      }
    },
    "android": {
      "package": "com.growvest.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/growvest-logo.png",
        "backgroundColor": "#085428"
      }
    },
    "web": {
      "favicon": "./assets/logo-h.jpeg"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "88b3eaf2-f492-41c1-9d89-027bebe60784"
      }
    },
    "owner": "itz-vp"
  }
}
